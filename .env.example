# LinkSports — single source of truth for backend, web and mobile.
# Real values live here (git-ignored). Template: .env.example

# ── Backend ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/linksports
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
CLIENT_URL=http://localhost:3000
# DEV ONLY: enables POST /auth/dev-login (ignored when NODE_ENV=production). Keep false in real environments.
DEV_LOGIN=false

# ── Email (OTP + notifications). If unset, OTPs are printed in the backend terminal ───
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=
EMAIL_FROM=LinkSports <noreply@linksports.in>

# ── Google login ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback

# ── Razorpay ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cloudinary (photo uploads) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Web app (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=https://www.linksports.in
NEXT_PUBLIC_CV_ONLY=true
# DEV ONLY: shows a "Skip login" button on the CV screen. Keep false in real environments.
NEXT_PUBLIC_DEV_LOGIN=false

# ── Mobile app (Expo). Emulator: leave blank. Physical phone: http://<PC-LAN-IP>:5000/api/v1 ───
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SITE_URL=https://www.linksports.in

# ── WhatsApp OTP via OpenWA gateway ────────────────────────────
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
